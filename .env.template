
STAGE=dev
DISABLE_SCHEDULED_TASKS=false

DB_PASSWORD=your_database_password
DB_NAME=SpamMusicDB
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres

PORT=3000
HOST_API=http://localhost:3000/api

# Debe ser un secreto aleatorio para firmar JWT y cursores de Actividad.
JWT_SECRET=your_long_random_jwt_secret

# Base64url sin padding de 32 bytes aleatorios; antes de rotarlo, invalida las solicitudes de reset pendientes.
AUTH_PASSWORD_RESET_TOKEN_SECRET=

# Frontend route that receives the reset token in the URL fragment.
AUTH_PASSWORD_RESET_URL=http://localhost:5173/reset-password
# Worker settings; defaults: enabled, poll 5s, lease 60s, 5 attempts,
# exponential backoff 30s to 15m. Lease must be at least 30s.
AUTH_PASSWORD_RESET_WORKER_ENABLED=true
AUTH_PASSWORD_RESET_WORKER_POLL_MS=5000
AUTH_PASSWORD_RESET_WORKER_LEASE_SECONDS=60
AUTH_PASSWORD_RESET_MAX_ATTEMPTS=5
AUTH_PASSWORD_RESET_BACKOFF_BASE_SECONDS=30
AUTH_PASSWORD_RESET_BACKOFF_MAX_SECONDS=900
AUTH_PASSWORD_RESET_RETENTION_DAYS=30

# Secreto privado del edge para validar X-RV-Session-Edge.
# Opcional; sin este valor las solicitudes de sesiones fallan cerradas.
# Debe ser base64url sin padding, con 43 caracteres (32 bytes aleatorios).
AUTH_SESSION_EDGE_SECRET=

# Origen adicional opcional para la app beta; ambos usan el cliente "app".
AUTH_SESSION_BETA_APP_ORIGIN=https://beta.riffvalley.es

SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/festival-playlists/spotify/callback
SPOTIFY_FRONTEND_REDIRECT_URL=http://localhost:5173/settings/integrations
SPOTIFY_TOKEN_ENCRYPTION_KEY=generate_a_random_secret_with_at_least_32_characters
SPOTIFY_REAUTH_NOTIFICATION_EMAIL=contacto@example.com

SETLISTFM_API_KEY=your_setlistfm_api_key

R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

LASTFM_API_KEY=your_lastfm_api_key

WP_API_URL=https://riffvalley.es/wp-json/wp/v2
WP_GRAPHQL_URL=https://riffvalley.es/graphql
WP_USER=your_wordpress_username
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

IG_ACCESS_TOKEN=your_instagram_graph_api_access_token
IG_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id
IG_GRAPH_API_VERSION=v21.0
IG_SYNC_CRON=*/10 * * * *

# Solo necesarias en Heroku, para que el refresh semanal del token de
# Instagram persista en las config vars en vez de en un .env efímero.
IG_HEROKU_API_TOKEN=your_heroku_platform_api_token
IG_HEROKU_APP_NAME=spammusic-back

TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_REDIRECT_URI=http://127.0.0.1:3000/api/tiktok/callback
TIKTOK_FRONTEND_REDIRECT_URL=http://localhost:5173/settings/integrations
TIKTOK_TOKEN_ENCRYPTION_KEY=generate_a_random_secret_with_at_least_32_characters
TIKTOK_REAUTH_NOTIFICATION_EMAIL=contacto@example.com
TIKTOK_SYNC_CRON=*/10 * * * *

MAIL_HOST=smtp.riffvalley.es
MAIL_PORT=587
MAIL_USER=contacto@riffvalley.es
MAIL_PASS=your_mail_password
MAIL_TO=contacto@riffvalley.es
# MAIL_USER remains the SMTP authentication identity. These control message headers.
# MAIL_FROM_DEFAULT may temporarily fall back to MAIL_USER for compatibility.
MAIL_FROM_DEFAULT=contacto@riffvalley.es
# Required by password-reset delivery; authorize this sender with the SMTP provider.
MAIL_FROM_NO_REPLY=no-reply@riffvalley.es
