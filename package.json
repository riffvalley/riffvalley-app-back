{
  "name": "riff-valley-app",
  "version": "0.0.1",
  "description": "Backend de Riff Valley App",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "nest build && node scripts/check-runtime-dependencies.js",
    "quality:types": "node scripts/type-safety-quality-gate.js",
    "quality:typecheck": "node scripts/typecheck-quality-gate.js",
    "quality:lint": "node scripts/eslint-quality-gate.js",
    "quality:structure": "node scripts/structural-quality-gate.js",
    "test:quality-build": "node --test scripts/nest-build-quality-gate.test.js",
    "test:quality-tests": "node --test scripts/jest-quality-gate.test.js",
    "test:quality-typecheck": "node --test scripts/typecheck-quality-gate.test.js",
    "test:quality-lint": "node --test scripts/eslint-quality-gate.test.js",
    "test:quality-types": "node --test scripts/type-safety-quality-gate.test.js",
    "test:quality-structure": "node --test scripts/structural-quality-gate.test.js",
    "test:quality-integration": "node --test scripts/quality-gate-integration.test.js",
    "test:runtime-dependencies": "node --test scripts/check-runtime-dependencies.test.js",
    "verify": "pnpm run test:quality-integration && pnpm run test:quality-structure && pnpm run quality:structure && pnpm run test:quality-types && pnpm run quality:types && pnpm run test:quality-lint && pnpm run quality:lint && pnpm run test:quality-typecheck && pnpm run quality:typecheck && pnpm run test:quality-build && pnpm run test:runtime-dependencies && pnpm run build && pnpm run test:quality-tests && pnpm run test:unit --runInBand",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:unit": "jest --config ./package.json",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm": "node --require ts-node/register --require tsconfig-paths/register ./node_modules/typeorm/cli.js --dataSource src/data-source.ts",
    "migration:create": "node --require ts-node/register --require tsconfig-paths/register ./node_modules/typeorm/cli.js migration:create --dataSource src/data-source.ts",
    "migration:generate": "node --require ts-node/register --require tsconfig-paths/register ./node_modules/typeorm/cli.js migration:generate --dataSource src/data-source.ts",
    "migration:run": "node --require ts-node/register --require tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run --dataSource src/data-source.ts",
    "migration:run:prod": "node ./node_modules/typeorm/cli.js migration:run --dataSource dist/data-source.js",
    "db:status": "node scripts/db-migrations.js status",
    "db:migrate": "node scripts/db-migrations.js migrate",
    "db:check": "node scripts/db-migrations.js check",
    "db:bootstrap-local": "node -r ts-node/register -r tsconfig-paths/register scripts/bootstrap-local-schema.ts",
    "music-search:backfill": "node dist/catalog/shared/music-name/music-search-key-backfill.cli.js",
    "test:db-bootstrap": "node scripts/local-bootstrap-guards.test.js",
    "db:bootstrap-catalog-test": "node -r ts-node/register -r tsconfig-paths/register scripts/bootstrap-catalog-test-schema.ts",
    "migration:revert": "node --require ts-node/register --require tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert --dataSource src/data-source.ts",
    "console": "node dist/standalone"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.990.0",
    "@nestjs/common": "^10.3.10",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mapped-types": "*",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/schedule": "^6.1.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^10.0.2",
    "@types/nodemailer": "^7.0.11",
    "bcrypt": "^5.1.1",
    "browsers": "^1.0.2",
    "cheerio": "^1.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "16.4.5",
    "exceljs": "^4.4.0",
    "express": "4.21.2",
    "lru-cache": "11.5.2",
    "nest-winston": "^1.10.2",
    "nodemailer": "^8.0.4",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "sanitize-html": "2.17.5",
    "typeorm": "^0.3.20",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.3.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "multer": "2.0.2",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": "src/.*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/src/$1"
    }
  },
  "packageManager": "pnpm@11.28.7"
}
